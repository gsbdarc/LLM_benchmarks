# .env.example — copy to `.env` and fill in YOUR OWN values.  `.env` is gitignored; never commit it.
#   cp .env.example .env
# Each teammate maintains their own .env (the existing repo .env belongs to another user).

# ── Agentic metric-eval (agent_eval/) — REQUIRED ────────────────────────────────
# MongoDB (DARC Atlas) — all data tools + the agentic_runs/agentic_evaluations mirror.
MONGO_DB_USERNAME=your_mongo_user
MONGO_DB_PASSWORD=your_mongo_password
# Stanford AI Playground — the hosted judge backend (backends/playground.json).
STANFORD_API_KEY=your_stanford_key

# ── Agentic metric-eval — OPTIONAL ──────────────────────────────────────────────
# Weave / W&B tracing. Omit and pass --no-weave, or set EVAL_DISABLE_WEAVE=1, to run without it.
WANDB_API_KEY=your_wandb_key
# Local vLLM/NIM judge only (backends/qwen.json uses $LOCAL_MODEL_URL). Set after the GPU job lands.
# LOCAL_MODEL_URL=http://yen-gpu2:40777/v1
# GPU_TYPE=NVIDIA A40
# MCP server host/port — the SLURM batch sets these itself; defaults are 127.0.0.1 / 8000.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# ── Upstream inference pipeline (scripts/) — only if you run 1_..7_ ─────────────
# BASE_DIR is the repo root; provider keys are needed for the non-Stanford models you run.
# BASE_DIR=/path/to/LLM_benchmarks
# OPENAI_API_KEY=your_openai_key
# GEMINI_API_KEY=your_gemini_key

# ── Generalized PDF extraction harness ──────────────────────────────────────
# Local values are accepted for development. Production uses Secret Manager refs.
# For a disposable UI preview without Mongo, set this to memory. Data resets when
# Streamlit restarts. Leave it as mongo for real extraction and benchmark work.
HARNESS_REPOSITORY_BACKEND=mongo
HARNESS_MONGO_URI=mongodb://localhost:27017
HARNESS_MONGO_DB=pdf_extraction_harness
HARNESS_GCS_BUCKET=your-private-pdf-bucket
HARNESS_GCP_PROJECT=your-gcp-project
HARNESS_GCP_REGION=us-west1
HARNESS_CLOUD_RUN_JOB=pdf-harness-worker
HARNESS_DISPATCH_URL=http://localhost:8080
HARNESS_APP_PASSWORD=change-me
# Optional W&B Weave mirror. Mongo remains authoritative and runs continue if W&B is down.
# WANDB_API_KEY=your_wandb_key
# HARNESS_WEAVE_PROJECT=darc/pdf-extraction-harness
# Admin-owned connector registry. Users cannot enter arbitrary URLs or secret refs.
# HARNESS_LLM_CONNECTORS_JSON=[{"id":"stanford","label":"Stanford AI API","base_url":"https://aiapi-prod.stanford.edu/v1","secret_ref":"env:STANFORD_API_KEY","allowed_models":["gpt-5-mini"]}]
# Optional Secret Manager resource containing the shared prototype password.
# HARNESS_APP_PASSWORD_SECRET=projects/PROJECT/secrets/pdf-harness-app-password/versions/latest
# Local artifact backend for development; production should use gcs.
HARNESS_ARTIFACT_BACKEND=local
HARNESS_LOCAL_DATA_DIR=.harness-data
HARNESS_MAX_UPLOAD_MB=200
